@page
@model AuPairServices.Pages.FamPrerequisitesReqModel

@{
    ViewData["Title"] = "Prerequisites / Requirements (Family)";
}

<div class="containerReg" role="main">
    <form>
        <div class="max-w-md mx-auto rounded-lg shadow-sm p-6 mb-6">
            <h1 class="display-4 vintage-text">Prerequisites / Requirements (Family)</h1>
            <div class="vintage-border pt-4"></div>
            <p class="mt-4 text-[#6D4C5B] font-serif leading-relaxed">
                To host an au pair, there are legal requirements and our terms and conditions.
                Requirements include sufficient living space for the au pair, proof of financial stability,
                and a commitment to the cultural exchange aspect of the program.
                In addition, we expect host families to support the au pair in their language
                development and integration into Dutch society.
            </p>
        </div>
    </form>
</div>
