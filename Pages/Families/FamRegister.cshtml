@page
@model AuPairServices.Pages.Families.FamRegisterModel
@{
    ViewData["Title"] = "Family Registration Form";
}

<style>
    
    p.lead {
        font-size: 1.125rem;
        color: var(--color-gray-600);
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    form input[type="text"],
    form input[type="email"],
    form input[type="file"] {
        width: 100%;
        padding: 0.6rem 1rem;
        border: 1.5px solid var(--input-border);
        border-radius: var(--input-radius);
        font-size: 1rem;
        background-color: var(--input-bg);
        transition: border-color var(--transition-duration);
        outline-offset: 2px;
    }

    form input[type="text"]:focus,
    form input[type="email"]:focus,
    form input[type="file"]:focus {
        border-color: var(--input-focus-border);
        outline: none;
        box-shadow: 0 0 8px rgb(37 99 235 / 0.3);
    }

    .validation-message {
        color: #dc2626; /* red-600 */
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    form button[type="submit"] {
        margin-top: 1.5rem;
        padding: 0.75rem 1.5rem;
        background-color: #2563eb;
        color: white;
        font-weight: 600;
        font-size: 1.125rem;
        border: none;
        border-radius: var(--input-radius);
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    form button[type="submit"]:hover,
    form button[type="submit"]:focus {
        background-color: #1d4ed8;
        outline: none;
    }

    .text-center {
        text-align: center;
        margin: 2rem 0 1rem;
    }
</style>

<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
    <p>
        Please input the following:
    </p>
</div>

<div class="containerReg" role="main">
    <form method="post" enctype="multipart/form-data" novalidate>
        <div class="max-w-md mx-auto bg-white rounded-lg shadow-sm p-6 mb-6">
            <div class="form-group mb-4">
                @Html.LabelFor(m => m.FamilyName, "Family Name", new { @class = "block text-gray-900 font-semibold text-lg mb-2" })
                @Html.TextBoxFor(m => m.FamilyName, new {
                @type = "text",
                @required = "required",
                @autocomplete = "family-name",
                @placeholder = "Enter your Family Name",
                @class = "w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
                })
                <span class="validation-message text-sm text-red-600 mt-1 block" asp-validation-for="FamilyName"></span>
            </div>

            <div class="form-group mb-4">
                @Html.LabelFor(m => m.Email, "Email Address", new { @class = "block text-gray-900 font-semibold text-lg mb-2" })
                @Html.TextBoxFor(m => m.Email, new {
                @type = "text",
                @required = "required",
                @autocomplete = "email-address",
                @placeholder = "Enter your Email Address",
                @class = "w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
                })
                <span class="validation-message text-sm text-red-600 mt-1 block" asp-validation-for="Email"></span>
            </div>

            <div class="form-group mb-4">
                <label for="photo1">Upload Photo 1</label>
                <input type="file" id="photo1" name="Photo1" accept="image/*" required />
                <span class="validation-message text-sm text-red-600 mt-1 block" asp-validation-for="Photo1"></span>
            </div>

            <div class="form-group mb-4">
                <label for="photo2">Upload Photo 2</label>
                <input type="file" id="photo2" name="Photo2" accept="image/*" required />
                <span class="validation-message text-sm text-red-600 mt-1 block" asp-validation-for="Photo2"></span>
            </div>

            <div class="form-group mb-4">
                <label for="photo3">Upload Photo 3</label>
                <input type="file" id="photo3" name="Photo3" accept="image/*" required />
                <span class="validation-message text-sm text-red-600 mt-1 block" asp-validation-for="Photo3"></span>
            </div>
        </div>

        <button type="submit" aria-label="Submit Family Registration Form">Submit</button>
    </form>
</div>