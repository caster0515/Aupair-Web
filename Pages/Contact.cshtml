@page
@model AuPairServices.Pages.ContactModel
@{
	ViewData["Title"] = "Contact Us";
}

<div class="containerReg" role="main">
    <form>
        <div class="max-w-md mx-auto rounded-lg shadow-sm p-6 mb-6">
            <h1 class="display-4 vintage-text">@ViewData["Title"]</h1>
            <div class="vintage-border pt-4"></div>
            <p class="mt-4 text-[#6D4C5B] font-serif leading-relaxed">
				Please contact us using the form below for any inquiries or support requests. 
                We will get back to you as soon as possible.
            </p>
        </div>
    </form>
</div>