</head>
<body>
    <header class="floral-bg">
        <nav class="navbar navbar-expand-lg salmon-pink-nav">
            <div class="container-fluid floral-bg">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/LogoMain.png" alt="Logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="mnuFamiliesDrop" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                FAMILIES
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="mnuFamiliesDrop">
                                <li><a class="dropdown-item" href="/Families/FamPrerequisitesReq">Prerequisites / Requirements</a></li>
                                <li><a class="dropdown-item" href="/Families/FamProcedure">Procedure</a></li>
                                <li><a class="dropdown-item" href="/Families/FamRegister">Family Registration</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="mnuAuPAirsDrop" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                AU PAIRS
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="servicesDrmnuAuPAirsDropopdown">
                                <li><a class="dropdown-item" href="/AuPairs/AuPairPrerequisite">Prerequisites and Requirements</a></li>
                                <li><a class="dropdown-item" href="/AuPairs/AuPairProcedure">Procedure</a></li>
                                <li><a class="dropdown-item" href="/AuPairs/OurAuPairs">Our Au Pairs</a></li>
                                <li><a class="dropdown-item" href="/AuPairs/AuPairRegister">Au Pairs Registration</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Contact">Contact</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/About">About</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div >
            &copy; 2025 - Au Pair Services - <a asp-area="" asp-page="/About">About</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>